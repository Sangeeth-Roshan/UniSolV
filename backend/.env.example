DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/unisolv
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# ML / Classification
CLASSIFIER_MODE=cached        # cached | live
LLM_PROVIDER=gemini           # gemini | groq  (used when CLASSIFIER_MODE=live)
GEMINI_API_KEY=               # required when LLM_PROVIDER=gemini
GROQ_API_KEY=                 # required when LLM_PROVIDER=groq
SIMILARITY_THRESHOLD=0.5      # cosine threshold below which → human review
